# Copy to .env for local runs. On Render, set these as environment variables instead.
# Never commit real values.

# One bearer token per client, as name:token pairs separated by commas, e.g.
#   demo:<24+ random chars>,judges:<24+ random chars>,dev:<24+ random chars>
# Names: lowercase letters, digits, - or _. Tokens: min 24 chars, all different, no commas
# (generate each with `openssl rand -hex 12`). Remove a pair to revoke that client.
ERRAND_CREW_TOKENS=

ANTHROPIC_API_KEY=
KERNEL_API_KEY=

# Optional overrides
# PLANNER_MODEL=claude-sonnet-5-5
# WORKER_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-haiku-5-5
# KERNEL_HEADLESS=false   # false (default): browsers with a screen, watchable in the Kernel dashboard
# MAX_CONCURRENT_ERRANDS=2
# MAX_ERRANDS_PER_HOUR=20
# MAX_ERRANDS_PER_DAY=100
# ALLOWED_HOSTS=your-service.onrender.com
# ALLOWED_ORIGINS=https://your-demo-origin.example
